# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medicare_db
DB_USERNAME=medicare_user
DB_PASSWORD=your_secure_password_here

# Server Configuration
SERVER_PORT=8080

# JWT Security
# Generate a secure 256-bit or 512-bit secret key for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Storage (Prescriptions)
UPLOAD_DIR=./uploads/prescriptions

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500

# Optional Mail Service (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
